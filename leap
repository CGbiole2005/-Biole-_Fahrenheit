#include <stdio.h>

int main() {
    int year;

    // Prompt user for a year
    printf("Enter a year: ");
    scanf("%d", &year);

    // Single if condition using logical operators
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) {
        printf("%d IS a leap year.\n", year);
    } else {
        printf("%d is NOT a leap year.\n", year);
    }

    return 0;
}
